{
	"name": "@ruplot/benchmarks",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Benchmark harness comparing ruplot vs uplot-react, react-uplot, and raw uPlot",
	"scripts": {
		"dev": "vite --config harness/vite.config.ts",
		"build:harness": "vite build --config harness/vite.config.ts",
		"bench": "node ./src/run-bench.mjs",
		"bench:compare": "node ./src/compare-baseline.mjs",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@playwright/test": "^1.50.0",
		"@ruplot/react": "workspace:*",
		"@types/react": "^19.0.7",
		"@types/react-dom": "^19.0.3",
		"@vitejs/plugin-react": "^4.3.4",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-uplot": "0.0.9",
		"typescript": "^5.7.3",
		"uplot": "^1.6.31",
		"uplot-react": "^1.2.4",
		"vite": "^6.0.7",
		"vitest": "^3.0.2"
	}
}
